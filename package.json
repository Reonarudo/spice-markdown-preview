{
  "name": "spice-schematic-preview",
  "version": "0.1.0",
  "displayName": "SPICE Schematic Preview",
  "description": "Draws SPICE netlists as circuit schematics in VS Code's built-in Markdown preview",
  "keywords": [
    "spice",
    "netlist",
    "schematic",
    "circuit",
    "electronics",
    "markdown",
    "markdown-preview"
  ],
  "icon": "media/icon.png",
  "publisher": "ReoX86",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reonarudo/spice-markdown-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Reonarudo/spice-markdown-preview/issues"
  },
  "homepage": "https://github.com/Reonarudo/spice-markdown-preview#readme",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Schematics draw in Restricted Mode; files named by .include and .lib are read only in a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Schematics draw; files named by .include and .lib are read only from a local folder."
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "media/preview.css"
    ],
    "configuration": {
      "title": "SPICE Schematic Preview",
      "properties": {
        "spice.dialect": {
          "type": "string",
          "enum": [
            "ngspice",
            "ltspice",
            "pspice",
            "hspice",
            "xyce",
            "spectre"
          ],
          "enumDescriptions": [
            "ngspice (the default)",
            "LTspice",
            "PSpice",
            "HSPICE",
            "Xyce",
            "Spectre"
          ],
          "default": "ngspice",
          "scope": "resource",
          "markdownDescription": "The dialect `spice` fences are read in, unless a fence names its own with a `dialect` attribute. Takes effect on the next render."
        },
        "spice.layoutTimeout": {
          "type": "number",
          "default": 3,
          "minimum": 0.5,
          "maximum": 60,
          "markdownDescription": "Seconds allowed to lay out one schematic before it is abandoned and reported as a timeout. Takes effect on the next render."
        }
      }
    },
    "commands": [
      {
        "command": "spice.refreshIncludes",
        "title": "SPICE: Refresh Included Files"
      }
    ]
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "grammars:compose": "tsx scripts/grammars/compose.ts",
    "grammars": "npm run grammars:compose && sh scripts/grammars.sh",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "test:extension": "node scripts/test-extension.mjs",
    "test:package": "node scripts/test-package.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.3",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.2",
    "playwright-core": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true,
    "fsevents@2.3.3": false
  }
}
